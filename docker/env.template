# ── 复制为 docker/.env.local（仅存在于部署副本，绝不提交 Git；规范 V1.0 §4.1）──
# 模板只放变量名、说明和占位符，绝不放真实值。

# ── 运行变量（规范 V1.0 §4.2）──
PROJECT_SLUG=personal-checkin
COMPOSE_PROJECT_NAME=personal-checkin
# 宿主机端口（端口约定：本项目避免占用 3000/3001/3100 等其他项目端口）
APP_PORT=8081
# 用户访问的完整 URL；改动公开地址时必须同步评估
# Supabase Auth Site URL / Redirect URL（数据库规范 V1.2 §6.3）
PUBLIC_APP_URL=http://localhost:8081
# 可回退版本标识（每次正式部署前保留上一镜像作为回滚点，规范 V1.0 §5.2）
IMAGE_TAG=latest

# ── 构建期公开变量（进入浏览器 bundle；规范 V1.2 §7.1 只放 URL + publishable key）──
# 改动后必须重建镜像（docker compose --env-file docker/.env.local build），不能只重启
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JSCODE=

# ── 服务端私密变量（只在容器内；绝不进镜像层、Git、日志、截图）──
# 大模型结构化整理：可选 openrouter / deepseek / opencode，逗号分隔为降级顺序
AI_PROVIDER_ORDER=openrouter,deepseek,opencode
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
OPENCODE_MODEL=
