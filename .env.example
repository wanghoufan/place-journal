# ── 复制本文件为 .env.local（本地）或在 Vercel Environment Variables 中配置真实值 ──
# 任何真实 Key 一律不得写入 Git。

# Supabase 共享项目（规范 V1.2 §7.1：浏览器端只放 URL + publishable key，
# service_role / 数据库密码 / MCP 令牌绝不进入前端包、Git、日志、截图）
# Data API 需在 Dashboard → API Settings → Exposed schemas 中显式暴露 habit_tracker
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# （旧名 VITE_SUPABASE_ANON_KEY 仍兼容读取，新配置请用上面的变量名）

# 高德地图 Web端(JS API) Key —— 会随浏览器可见，安全边界靠域名白名单
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JSCODE=

# ── 以下均为服务端变量（Vercel Functions / 本地 .env.local，绝不进入前端包）──

# 大模型结构化整理：可选 openrouter / deepseek / opencode，逗号分隔为降级顺序
AI_PROVIDER_ORDER=openrouter,deepseek,opencode

# 模型名可由前端「我的 → AI 模型设置」逐家覆盖（只发模型名，Key 永远只在服务端）；
# 前端没设覆盖时，用下面这些环境变量里的默认名。

OPENROUTER_API_KEY=
# OpenRouter 默认保持自动选路，一般不用改
OPENROUTER_MODEL=openrouter/auto

DEEPSEEK_API_KEY=
# 现行默认 deepseek-flash（V4.1-Flash）；旧默认 deepseek-chat 已于 2026-07-24 退役，不要再用
DEEPSEEK_MODEL=deepseek-flash

# OpenCode：按 OpenAI 兼容端点处理，三件套一起填才生效——
#   OPENCODE_API_KEY   ：OpenCode 的 Key（只放服务端）
#   OPENCODE_BASE_URL  ：填 base 即可，程序自动补 /chat/completions，如 https://opencode.ai/zen/go/v1
#   OPENCODE_MODEL     ：模型名由用户自填（以 OpenCode 后台为准，如 glm-5.3-flash）
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
OPENCODE_MODEL=
